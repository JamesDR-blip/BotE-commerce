# Production environment template.
#
# Copy this file to a deployment secret store or an untracked .env file.
# Never commit real credentials.
#
ENVIRONMENT=production
LOG_LEVEL=INFO

POSTGRES_DB=ai_studio
POSTGRES_USER=ai_studio
POSTGRES_PASSWORD=CHANGE_ME_TO_A_RANDOM_SECRET

REDIS_STREAM_NAME=ai-studio:workflow-executions
REDIS_CONSUMER_GROUP=workflow-workers

OTEL_SERVICE_NAME=ai-data-studio-api
OTEL_EXPORTER_OTLP_ENDPOINT=

# Optional application secrets:
# GOOGLE_API_KEY=
# CHANNEL_CREDENTIALS_ENCRYPTION_KEY=
